# Copy to backend/.env (gitignored). docker-compose loads it into web/worker/beat.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Inside docker compose the database host is "db" on 5432.
DB_NAME=service_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BOOKING_BLOCK_MINUTES=120
SLOT_STEP_MINUTES=30
AUTH_THROTTLE_RATE=30/min

# Only for running GeoDjango natively on Windows (OSGeo4W); leave empty in Docker.
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=
